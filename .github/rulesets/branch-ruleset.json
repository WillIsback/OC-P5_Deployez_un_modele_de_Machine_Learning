{
  "name": "Protection de main",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": ["refs/heads/main"],
      "exclude": []
    }
  },
  "bypass_actors": [
    {
      "actor_id": 5,
      "actor_type": "RepositoryRole",
      "bypass_mode": "always"
    }
  ],
  "rules": [
    {
      "type": "creation",
      "parameters": {
        "enabled": true
      }
    },
    {
      "type": "deletion",
      "parameters": {
        "enabled": true
      }
    },
    {
      "type": "update",
      "parameters": {
        "update_allows_fetch_and_merge": false
      }
    },
    {
      "type": "required_linear_history",
      "parameters": {
        "enabled": true
      }
    },
    {
      "type": "force_pushes",
      "parameters": {
        "enabled": true,
        "block_force_pushes": true,
        "block_deletions": true
      }
    },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 0,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_review_thread_resolution": true,
        "dismiss_stale_reviews_on_push": true,
        "require_branches_to_be_up_to_date": true
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict": true,
        "contexts": [
          "ci-code-quality",
          "ci-test",
          "ci-security",
          "ci-traceability",
          "release / gate-version-consistency",
          "release / gate-container-scan"
        ]
      }
    },
    {
      "type": "branch_name_pattern",
      "parameters": {
        "name": "Convention de branche",
        "pattern": "^(feat|fix|refactor|docs|chore|hotfix|release)/[a-z0-9._-]+$",
        "matching": "regex"
      }
    },
    {
      "type": "commit_message_pattern",
      "parameters": {
        "name": "Conventional Commits",
        "pattern": "^(feat|fix|refactor|docs|test|chore|perf|ci|build|revert)(\\(.+\\))?!?: .+",
        "matching": "regex"
      }
    },
    {
      "type": "merge_queue",
      "parameters": {
        "grouping_strategy": "HEAD_REF",
        "require_merge_queue_on_update": true
      }
    },
    {
      "type": "require_ci",
      "parameters": {
        "enabled": false
      }
    },
    {
      "type": "non_fast_forward",
      "parameters": {
        "enabled": true
      }
    },
    {
      "type": "secret_scanning_push_protection",
      "parameters": {
        "enabled": true
      }
    },
    {
      "type": "dependabot_alerts_blocked",
      "parameters": {
        "enabled": true
      }
    }
  ]
}