{
  "name": "Protection des branches de travail",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": [
        "refs/heads/feat/*",
        "refs/heads/fix/*",
        "refs/heads/refactor/*",
        "refs/heads/docs/*",
        "refs/heads/chore/*",
        "refs/heads/hotfix/*",
        "refs/heads/release/*"
      ],
      "exclude": ["refs/heads/main"]
    }
  },
  "bypass_actors": [
    {
      "actor_id": null,
      "actor_type": "RepositoryRole",
      "bypass_mode": "always",
      "repository_role_id": 2
    }
  ],
  "rules": [
    {
      "type": "creation",
      "parameters": {
        "enabled": true
      }
    },
    {
      "type": "deletion",
      "parameters": {
        "enabled": true
      }
    },
    {
      "type": "update",
      "parameters": {
        "update_allows_fetch_and_merge": false
      }
    },
    {
      "type": "force_pushes",
      "parameters": {
        "enabled": true,
        "block_force_pushes": false,
        "block_deletions": false,
        "require_linear_history": false,
        "allow_force_pushes_from_authenticated": true,
        "restrict_force_pushes_to_non_admins": false
      }
    },
    {
      "type": "branch_name_pattern",
      "parameters": {
        "name": "Convention de branche",
        "pattern": "^(feat|fix|refactor|docs|chore|hotfix|release)/[a-z0-9._-]+$",
        "matching": "regex"
      }
    },
    {
      "type": "require_ci",
      "parameters": {
        "enabled": false
      }
    }
  ]
}